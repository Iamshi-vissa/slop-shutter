{
  "name": "slop-shutter",
  "version": "1.2.0",
  "description": "Flag AI slop and generated-text patterns in prose, web pages and source code.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slop-shutter": "bin/slop-shutter.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "server",
    "server.js",
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node bin/slop-shutter.js serve",
    "start:prod": "NODE_ENV=production HOST=0.0.0.0 node server.js",
    "serve:api": "node bin/slop-shutter.js serve",
    "scan": "node bin/slop-shutter.js scan",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
